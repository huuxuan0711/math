<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.SampleProject" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/surface_variant</item>
    </style>

    <style name="Theme.SampleProject" parent="Base.Theme.SampleProject" />

    <!-- Card style for items -->
    <style name="ImageFlow.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">3dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- Button primary style -->
    <style name="ImageFlow.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Status chip style -->
    <style name="ImageFlow.StatusText" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <!-- Section header -->
    <style name="ImageFlow.SectionHeader" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
