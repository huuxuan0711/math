<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Nút bấm chạy bài test -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 Thử Nghiệm Đồng Bộ Hóa (4 Luồng x 100.000 lần)"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/primary"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kỳ vọng chuẩn: 400.000. So sánh kết quả và tốc độ thực thi giữa các cơ chế."
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginVertical="6dp"/>

                <Button
                    android:id="@+id/btnRunSyncDemo"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="▶ BẮT ĐẦU CHẠY THỬ NGHIỆM"
                    android:backgroundTint="@color/primary"/>

                <ProgressBar
                    android:id="@+id/pbSyncDemo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 1. Biến thông thường (Race Condition) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1. Biến int thường "
                        android:textStyle="bold"
                        android:textColor="@color/status_failed"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvNoSyncTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ms"
                        android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thực tế: "
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvNoSyncResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="---"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/status_failed"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" (Kỳ vọng: 400.000)"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Biến volatile (Vẫn lỗi vì volatile KHÔNG đảm bảo tính nguyên tử) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2. Biến volatile int "
                        android:textStyle="bold"
                        android:textColor="#E65100"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvVolatileTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ms"
                        android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thực tế: "
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvVolatileResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="---"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#E65100"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" (Kỳ vọng: 400.000)"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>


            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Synchronized -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="3. Dùng Synchronized Method"
                        android:textStyle="bold"
                        android:textColor="@color/status_downloading"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvSyncTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ms"
                        android:textSize="12sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSyncResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/status_completed"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. AtomicInteger -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="4. Dùng AtomicInteger"
                        android:textStyle="bold"
                        android:textColor="@color/accent"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvAtomicTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ms"
                        android:textSize="12sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAtomicResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/accent"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Divider ngăn cách 2 case -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider"/>

        <!-- CASE 2: Thử nghiệm rút tiền đồng thời (ATM Race Condition) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏧 Thử Nghiệm Rút Tiền Đồng Thời (2 Luồng ATM)"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/primary"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tài khoản chung còn 100k. Người A và Người B cùng rút 100k cùng lúc. Kỳ vọng: chỉ 1 người rút được, số dư còn 0k."
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginVertical="6dp"/>

                <Button
                    android:id="@+id/btnRunWithdrawDemo"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="▶ BẮT ĐẦU CHẠY THỬ NGHIỆM RÚT TIỀN"
                    android:backgroundTint="@color/primary"/>

                <ProgressBar
                    android:id="@+id/pbWithdrawDemo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 1. Tài khoản không đồng bộ (Race Condition) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1. Không đồng bộ (UnsafeAccount)"
                        android:textStyle="bold"
                        android:textColor="@color/status_failed"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvUnsafeWithdrawTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ms"
                        android:textSize="12sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvUnsafeWithdrawDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Người A: --- | Người B: ---"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tvUnsafeWithdrawBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Số dư cuối: ---"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/status_failed"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Tài khoản dùng Synchronized (SafeAccount) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2. Dùng Synchronized (SafeAccount)"
                        android:textStyle="bold"
                        android:textColor="@color/status_downloading"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvSafeWithdrawTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ms"
                        android:textSize="12sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSafeWithdrawDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Người A: --- | Người B: ---"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tvSafeWithdrawBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Số dư cuối: ---"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/status_completed"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Divider ngăn cách Case 2 và Case 3 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider"/>

        <!-- CASE 3: Chuyển tiền 2 chiều (Deadlock & Lock Ordering) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔁 Thử Nghiệm Chuyển Tiền 2 Chiều (Deadlock)"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/primary"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A (100k) chuyển 50k → B và B (100k) chuyển 30k → A cùng lúc. Kỳ vọng: A = 80k, B = 120k (Tổng = 200k)."
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginVertical="6dp"/>

                <Button
                    android:id="@+id/btnRunDeadlockDemo"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="▶ BẮT ĐẦU CHẠY THỬ NGHIỆM DEADLOCK"
                    android:backgroundTint="@color/primary"/>

                <ProgressBar
                    android:id="@+id/pbDeadlockDemo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 1. Khóa sai thứ tự (Gây Deadlock) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1. Khóa theo chiều gọi (from → to)"
                        android:textStyle="bold"
                        android:textColor="@color/status_failed"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvDeadlockTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ms"
                        android:textSize="12sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDeadlockDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Luồng 1 (A → B) | Luồng 2 (B → A)"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tvDeadlockResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trạng thái: ---"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/status_failed"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Khắc phục bằng Lock Ordering -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2. Lock Ordering (Khóa theo ID nhỏ → lớn)"
                        android:textStyle="bold"
                        android:textColor="@color/status_downloading"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvLockOrderTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ms"
                        android:textSize="12sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLockOrderDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Luồng 1 (A → B) | Luồng 2 (B → A)"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tvLockOrderResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trạng thái: ---"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/status_completed"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
